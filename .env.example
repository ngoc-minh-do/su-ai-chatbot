# LLM backend selection (openai, ollama, huggingface, llama_cpp)
SELECTED_MODEL=openai

# Data directory for model caches
DATA_DIR="/path/to/data"
HF_HOME="${DATA_DIR}/huggingface"
HF_HUB_CACHE="${HF_HOME}/hub"
TRANSFORMERS_CACHE="${HF_HUB_CACHE}"
HF_TOKEN=your_huggingface_token_here
TOKENIZERS_PARALLELISM=false

# Logging level (DEBUG, INFO, WARNING, ERROR)
LOGLEVEL="INFO"

# OpenAI
OPENAI_API_KEY=sk-your-key-here
OPENAI_API_URL=http://openai.example.local/v1
OPENAI_MODEL=your-model

# Ollama
OLLAMA_URL=http://ollama.example.local
OLLAMA_MODEL=qwen3:8b

# Qdrant vector store
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION_NAME=su-ai-chatbot

# PostgreSQL
DATABASE_URL=postgresql://user:password@host:5432/su_ai_chatbot

# llama.cpp: keep CUDA graphs off (graph replay/recapture stalls generation on consumer GPUs)
GGML_CUDA_DISABLE_GRAPHS=1

# LLM parameters
MAX_TOKENS=1024
TEMPERATURE=0.8
CONTEXT_WINDOW=8192
N_GPU_LAYERS=-1   # -1 = all layers on GPU; 32 leaves block 0 on CPU (slow decode)
N_BATCH=256
STREAM=true

# Query enhancement (MultiQueryRetriever)
QUERY_ENHANCEMENT=false
